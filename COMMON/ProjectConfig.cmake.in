### Installation directory
set (CMAKE_INSTALL_PREFIX ${CMAKE_SOURCE_DIR})

include(Util)
if(NOT DEFINED LIBNEO_REF)
    set(LIBNEO_REF 7262c32bf0406594a8ef27e84654d249aef2cb86)
endif()
find_or_fetch(libneo)

# fortnum may already be present as a target if a transitive dependency (e.g.
# libneo) pulled it in; only declare it once. In the default build libneo fetches
# fortnum first, so this fetch is a fallback for configurations where libneo does
# not provide it. Keep the pin in sync with libneo (CMakeLists.txt fortnum
# GIT_TAG) so both paths resolve the same revision. Prefer a local checkout in
# $CODE/fortnum, otherwise fetch the pinned revision over https.
if(NOT TARGET fortnum)
    if(DEFINED ENV{CODE} AND EXISTS $ENV{CODE}/fortnum)
        message(STATUS "Using fortnum in $ENV{CODE}/fortnum")
        add_subdirectory($ENV{CODE}/fortnum ${CMAKE_CURRENT_BINARY_DIR}/fortnum
            EXCLUDE_FROM_ALL)
    else()
        FetchContent_Declare(fortnum
            GIT_REPOSITORY https://github.com/lazy-fortran/fortnum.git
            GIT_TAG 62a559c0b8e1b28bd63550164a09ed9644e659b1
        )
        FetchContent_MakeAvailable(fortnum)
    endif()
endif()

### FGSL
# Hermetic by default: fetch and build FGSL via the bundled ExternalProject.
# Pass -DFGSL_PATH=<prebuilt-fgsl-dir> to build against a local FGSL instead.
if (FGSL_PATH)
    message(STATUS "Using local FGSL in ${FGSL_PATH}")
    add_custom_target(FGSL)
else()
    message(STATUS "Downloading and building FGSL")
    include(fgsl)

    set(FGSL_PATH ${CMAKE_BINARY_DIR}/fgsl/src/FGSL CACHE STRING "FGSL path")
endif()

set(FGSL_INC ${FGSL_PATH} CACHE STRING "FGSL include")
set(LIBFGSL ${FGSL_PATH}/.libs/libfgsl${CMAKE_STATIC_LIBRARY_SUFFIX} CACHE STRING "FGSL lib")


### Directories of MPE
set(MPE_PATH /afs/itp.tugraz.at/opt/mpe/1.3.0/)
