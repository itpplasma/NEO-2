execute_process(COMMAND "${EXECUTABLE}" --singular
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(status EQUAL 0)
    message(FATAL_ERROR "Singular native factorization unexpectedly succeeded")
endif()
set(receipt "${output}\n${errors}")
if(NOT receipt MATCHES "NEO-2 native sparse:")
    message(FATAL_ERROR "Failure did not originate in native adapter: ${receipt}")
endif()
string(REGEX MATCH "Expected singular code=([0-9]+)" expected "${receipt}")
set(expected_code "${CMAKE_MATCH_1}")
string(REGEX MATCH "FortSparse status=([0-9]+)" actual "${receipt}")
set(actual_code "${CMAKE_MATCH_1}")
if(expected_code STREQUAL "" OR NOT actual_code STREQUAL expected_code)
    message(FATAL_ERROR "Expected singular-factor status: ${receipt}")
endif()
