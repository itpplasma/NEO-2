set(command "${EXECUTABLE}" --singular)
if(DEFINED ARGUMENT)
    set(command "${EXECUTABLE}" "${ARGUMENT}")
endif()
if(DEFINED MPIEXEC)
    set(command "${MPIEXEC}" "${NUMPROC_FLAG}" 2 ${command})
endif()
execute_process(COMMAND ${command}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 5)
if(status EQUAL 0 OR status MATCHES "timeout")
    message(FATAL_ERROR "Native failure case unexpectedly succeeded or timed out")
endif()
set(receipt "${output}\n${errors}")
if(NOT receipt MATCHES "NEO-2 native sparse:")
    message(FATAL_ERROR "Failure did not originate in native adapter: ${receipt}")
endif()
string(REGEX MATCH "Expected (singular|resource) code=([0-9]+)" expected "${receipt}")
set(expected_kind "${CMAKE_MATCH_1}")
set(expected_code "${CMAKE_MATCH_2}")
string(REGEX MATCH "FortSparse status=([0-9]+)" actual "${receipt}")
set(actual_code "${CMAKE_MATCH_1}")
if(expected_code STREQUAL "" OR NOT actual_code STREQUAL expected_code)
    message(FATAL_ERROR "Expected native factor status: ${receipt}")
endif()

if(NOT DEFINED MPIEXEC AND NOT status EQUAL expected_code)
    message(FATAL_ERROR "Native exit status ${status} differs from ${expected_code}: ${receipt}")
endif()

if(DEFINED MPIEXEC AND NOT receipt MATCHES "NEO-2 sparse failure rank=1")
    message(FATAL_ERROR "Missing failing MPI rank diagnostic: ${receipt}")
endif()

if(expected_kind STREQUAL "resource")
    string(REGEX MATCH "Sparse budget required bytes=([0-9]+)" required "${receipt}")
    set(required_bytes "${CMAKE_MATCH_1}")
    string(REGEX MATCH "Sparse budget available bytes=([0-9]+)" available "${receipt}")
    set(available_bytes "${CMAKE_MATCH_1}")
    if(required_bytes STREQUAL "" OR available_bytes STREQUAL ""
       OR NOT required_bytes GREATER available_bytes)
        message(FATAL_ERROR "Missing/invalid payload failure amounts: ${receipt}")
    endif()
endif()
